#!/usr/bin/env bash
#
# amd — a tiny filesystem Kanban in markdown (agile-md).
#
# Install this on your PATH (see agile-md/install.sh) and it operates on the
# board at <repository-root>/tasks (todo/ doing/ done/), discovered from your
# current directory — so `amd` works in any git repository.
#
#   amd init                          create the board in this repository
#   amd new "<title>" [options]       create a task in todo/
#   amd board [filters]               show all columns (default)
#   amd ls [todo|doing|done|archive|all] [filters]
#   amd start <ref>                   todo  -> doing
#   amd done  <ref>                   doing -> done
#   amd back  <ref>                   move a task one column left
#   amd show  <ref>                   print a task
#   amd edit  <ref>                   open a task in $EDITOR
#   amd set   <ref> <field> <value>   set priority or repository on a task
#   amd archive <ref>                 take a task off the board, into archive/
#   amd clean                         delete everything in archive/ for good
#
# Options for `new`:  -t <tag> (repeatable), -p <priority>, -r <repository>
# Filters for `board`/`ls`:
#   -r, --repo <substring>            only tasks whose repository matches
#   -s, --sort id|priority            ordering (default: id)
#
# Priority is high, medium or low (prefixes work: -p h). A task created
# without -r records the repository you created it in, so one board can track
# work across several repositories and filter it back out again.
#
# Archived tasks stay on disk but leave the board and the history: archive/ is
# gitignored. `amd ls archive` lists them; `amd clean` is the only thing that
# deletes anything.
#
# <ref> is a task id (e.g. 7 or 007) or a unique slug substring.
# Set AMD_DIR to use a board directory other than "tasks", AMD_SORT to change
# the default ordering.
#
set -euo pipefail

COLUMNS=(todo doing "done")

# Set by parse_filters(); declared here so `set -u` is safe everywhere.
FILTER_REPO=""
SORT="${AMD_SORT:-id}"

die() { printf 'amd: %s\n' "$*" >&2; exit 1; }

# Board = <repo-root>/${AMD_DIR:-tasks}, discovered from the current directory.
board_dir() {
  local root
  root="$(git rev-parse --show-toplevel 2>/dev/null || true)"
  [ -n "${root}" ] || die "not inside a git repository (agile-md boards live at <repo>/${AMD_DIR:-tasks})"
  printf '%s/%s' "${root}" "${AMD_DIR:-tasks}"
}

slugify() {
  printf '%s' "$1" | tr '[:upper:]' '[:lower:]' \
    | sed -E 's/[^a-z0-9]+/-/g; s/^-+//; s/-+$//' | cut -c1-50
}

meta() { awk -F'"' -v k="$2" 'index($0, k": ")==1 {print $2; exit}' "$1"; }

column_of() { basename "$(dirname "$1")"; }

lower() { printf '%s' "${1:-}" | tr '[:upper:]' '[:lower:]'; }

# Priorities are words in the file and ranks when sorting. Anything unset or
# unrecognised ranks last, so boards written before priorities existed still
# sort sensibly.
priority_rank() {
  case "$(lower "${1:-}")" in
    high) printf '1' ;;
    medium) printf '2' ;;
    low) printf '3' ;;
    *) printf '4' ;;
  esac
}

priority_of() { # <level-or-prefix> -> canonical level
  case "$(lower "${1:-}")" in
    h|hi|high) printf 'high' ;;
    m|med|medium) printf 'medium' ;;
    l|lo|low) printf 'low' ;;
    *) die "unknown priority '${1:-}' (use: high, medium, low)" ;;
  esac
}

sort_of() { # <key> -> canonical sort key
  case "$(lower "${1:-}")" in
    id) printf 'id' ;;
    p|pri|priority) printf 'priority' ;;
    *) die "unknown sort '${1:-}' (use: id, priority)" ;;
  esac
}

# The repository a task belongs to, defaulting to the one you're standing in:
# owner/name from the origin remote, else the repo directory's name.
default_repo() {
  local url base name rest root
  url="$(git config --get remote.origin.url 2>/dev/null || true)"
  if [ -n "${url}" ]; then
    base="${url%.git}"; base="${base%/}"
    name="${base##*/}"; rest="${base%/*}"
    printf '%s/%s' "${rest##*[:/]}" "${name}"
    return 0
  fi
  root="$(git rev-parse --show-toplevel 2>/dev/null || true)"
  if [ -n "${root}" ]; then printf '%s' "$(basename "${root}")"; fi
}

# Substring, case-insensitive — the same forgiving matching as a task <ref>.
repo_matches() { # <task-repository>
  local have want
  [ -n "${FILTER_REPO}" ] || return 0
  have="$(lower "${1:-}")"; want="$(lower "${FILTER_REPO}")"
  case "${have}" in
    *"${want}"*) return 0 ;;
    *) return 1 ;;
  esac
}

next_id() {
  local max=0 n f c
  # Archived tasks still hold their ids: reusing one would point every
  # reference at a different task.
  for c in "${COLUMNS[@]}" archive; do
    for f in "${BOARD}/${c}"/*.md; do
      [ -e "${f}" ] || continue
      n="$(basename "${f}" | sed -E 's/^0*([0-9]+)-.*/\1/')"
      [[ "${n}" =~ ^[0-9]+$ ]] && [ "${n}" -gt "${max}" ] && max="${n}"
    done
  done
  printf '%03d' $((max + 1))
}

find_task() { # <ref> -> prints the matching file path (must be unique)
  local ref="$1" f base c hits=()
  for c in "${COLUMNS[@]}"; do
    for f in "${BOARD}/${c}"/*.md; do
      [ -e "${f}" ] || continue
      base="$(basename "${f}" .md)"
      if [[ "${ref}" =~ ^[0-9]+$ ]]; then
        [[ "${base}" =~ ^0*${ref}- ]] && hits+=("${f}")
      else
        [[ "${base}" == *"${ref}"* ]] && hits+=("${f}")
      fi
    done
  done
  [ "${#hits[@]}" -eq 0 ] && die "no task matches '${ref}'"
  [ "${#hits[@]}" -gt 1 ] && die "'${ref}' matches ${#hits[@]} tasks; be more specific"
  printf '%s' "${hits[0]}"
}

move() { # <file> <dest-column>
  local src="$1" col="$2" dest
  dest="${BOARD}/${col}/$(basename "${src}")"
  [ "$(column_of "${src}")" = "${col}" ] && die "already in ${col}/"
  if git -C "${BOARD}" ls-files --error-unmatch "${src}" >/dev/null 2>&1; then
    git -C "${BOARD}" mv "${src}" "${dest}"
  else
    mv "${src}" "${dest}"
  fi
  printf 'moved %s -> %s/\n' "$(basename "${src}")" "${col}"
}

# The drawer itself is tracked; what you put in it is not. Boards created
# before archive/ existed get theirs on first use, so an archived task can
# never arrive in a directory that git is still watching.
ensure_archive() {
  mkdir -p "${BOARD}/archive"
  if [ ! -e "${BOARD}/archive/.gitignore" ]; then
    printf '*\n!.gitignore\n' > "${BOARD}/archive/.gitignore"
  fi
}

archive_task() { # <file> — off the board, but still on disk
  local src="$1" name dest
  name="$(basename "${src}")"
  dest="${BOARD}/archive/${name}"
  ensure_archive
  if [ -e "${dest}" ]; then die "${dest} already exists"; fi
  # archive/ is gitignored, so `git mv` would refuse the destination and
  # forcing it would put the archive back into the history the .gitignore
  # exists to keep out. Drop it from the index instead, then move the file.
  if git -C "${BOARD}" ls-files --error-unmatch "${src}" >/dev/null 2>&1; then
    git -C "${BOARD}" rm --cached --quiet -- "${src}" >/dev/null
  fi
  mv "${src}" "${dest}"
  printf 'archived %s -> archive/\n' "${name}"
}

clean_archive() { # the only command that deletes anything
  local f reply files=()
  for f in "${BOARD}/archive"/*.md; do
    [ -e "${f}" ] || continue
    files+=("${f}")
  done
  if [ "${#files[@]}" -eq 0 ]; then
    printf 'archive is already empty\n'
    return 0
  fi
  if [ "${AMD_YES:-}" = "1" ]; then
    reply=y
  elif [ -t 0 ]; then
    printf 'Delete %s archived task(s) from %s? [y/N] ' "${#files[@]}" "${BOARD}/archive" >&2
    read -r reply
  else
    die "refusing to delete ${#files[@]} archived task(s) unprompted (set AMD_YES=1)"
  fi
  case "${reply}" in
    y|Y|yes|Yes|YES)
      rm -f -- "${files[@]}"
      printf 'deleted %s archived task(s)\n' "${#files[@]}"
      ;;
    *) die "nothing deleted" ;;
  esac
}

set_field() { # <file> <key> <value> — replace the key in the frontmatter, or add it
  local file="$1" key="$2" value="$3" tmp first=""
  tmp="${file}.amd.tmp"
  IFS= read -r first < "${file}" || true
  [ "${first}" = "---" ] || die "$(basename "${file}") has no frontmatter to set ${key} in"
  awk -v k="${key}" -v v="${value}" '
    NR == 1 { print; next }
    !set && index($0, k": ") == 1 { printf "%s: \"%s\"\n", k, v; set = 1; next }
    !set && $0 == "---" { printf "%s: \"%s\"\n", k, v; set = 1; print; next }
    { print }
  ' "${file}" > "${tmp}"
  mv "${tmp}" "${file}"
  printf '%s: %s -> %s\n' "$(basename "${file}" .md)" "${key}" "${value}"
}

# Rows are built as "rank<TAB>id<TAB>line" so one `sort` handles both orderings;
# the keys are cut back off before printing.
list_column() {
  local c="$1" f id idnum title pri repo line rows=() keys=()
  printf '\n%s\n' "$(printf '%s' "${c}" | tr '[:lower:]' '[:upper:]')"
  for f in "${BOARD}/${c}"/*.md; do
    [ -e "${f}" ] || continue
    repo="$(meta "${f}" repository)"
    repo_matches "${repo}" || continue
    id="$(meta "${f}" id)"; title="$(meta "${f}" title)"; pri="$(meta "${f}" priority)"
    idnum="$(basename "${f}" | sed -E 's/^0*([0-9]+)-.*/\1/')"
    if ! [[ "${idnum}" =~ ^[0-9]+$ ]]; then idnum=999999; fi
    line="$(printf '  [%s] %-7s%s' "${id:-???}" "$(lower "${pri:--}")" \
      "${title:-$(basename "${f}" .md)}")"
    if [ -n "${repo}" ]; then line="${line}  @${repo}"; fi
    rows+=("$(priority_rank "${pri}")"$'\t'"${idnum}"$'\t'"${line}")
  done
  if [ "${#rows[@]}" -eq 0 ]; then printf '  (empty)\n'; return 0; fi
  case "${SORT}" in
    priority) keys=(-t $'\t' "-k1,1n" "-k2,2n") ;;
    *) keys=(-t $'\t' "-k2,2n") ;;
  esac
  printf '%s\n' "${rows[@]}" | sort "${keys[@]}" | cut -f3-
}

create_board() { # scaffolds the board at $BOARD
  mkdir -p "${BOARD}/todo" "${BOARD}/doing" "${BOARD}/done"
  for c in todo doing "done"; do
    [ -e "${BOARD}/${c}/.gitkeep" ] || : > "${BOARD}/${c}/.gitkeep"
  done
  ensure_archive
  if [ ! -e "${BOARD}/README.md" ]; then
    printf '# Tasks (agile-md)\n\nA filesystem Kanban managed by the `amd` command.\nStatus is the folder; `git mv` between columns is the audit trail.\nSee https://github.com/mrdoodles/agile-md\n' > "${BOARD}/README.md"
  fi
}

# Resolve the board; if it doesn't exist, offer to create it (prompt when
# interactive, AMD_YES=1 to force, otherwise a clear error so it never hangs).
ensure_board() {
  BOARD="$(board_dir)"
  # Every command repairs a missing archive/.gitignore on the way past: losing
  # it is how archived tasks would quietly get committed, and the check costs
  # one stat on a board that's already fine.
  if [ -d "${BOARD}" ]; then ensure_archive; return 0; fi
  local reply=""
  if [ "${AMD_YES:-}" = "1" ]; then
    reply=y
  elif [ -t 0 ]; then
    printf 'No task board found at %s\nCreate an empty board here? [y/N] ' "${BOARD}" >&2
    read -r reply
  else
    die "no board at ${BOARD} — run 'amd init' (or set AMD_YES=1)"
  fi
  case "${reply}" in
    y|Y|yes|Yes|YES) create_board; printf 'Created board at %s\n' "${BOARD}" >&2 ;;
    *) die "no board created" ;;
  esac
}

# Shared by `board` and `ls`: sets FILTER_REPO, SORT and TARGET.
parse_filters() {
  TARGET="all"
  while [ $# -gt 0 ]; do
    case "$1" in
      -r|--repo|--repository)
        [ $# -ge 2 ] || die "$1 needs a repository"
        FILTER_REPO="$2"; shift 2 ;;
      -s|--sort)
        [ $# -ge 2 ] || die "$1 needs a sort key (id, priority)"
        SORT="$(sort_of "$2")"; shift 2 ;;
      -*) die "unknown option '$1' (try: amd help)" ;;
      *) TARGET="$1"; shift ;;
    esac
  done
  case "${TARGET}" in
    all|todo|doing|"done"|archive) ;;
    *) die "unknown column '${TARGET}' (use: todo, doing, done, archive, all)" ;;
  esac
}

usage() { awk 'NR>=3 && /^#/ {sub(/^# ?/, ""); print; next} NR>=3 {exit}' "${BASH_SOURCE[0]}"; }

cmd="${1:-board}"; [ $# -gt 0 ] && shift || true

case "${cmd}" in help|-h|--help) usage; exit 0 ;; esac

if [ "${cmd}" = "init" ]; then
  BOARD="$(board_dir)"
  create_board
  printf 'Initialised agile-md board at %s\n' "${BOARD}"
  exit 0
fi

ensure_board

case "${cmd}" in
  new)
    title="${1:-}"
    [ -n "${title}" ] || die 'usage: amd new "<title>" [-t tag ...] [-p priority] [-r repository]'
    shift
    tags=(); priority="medium"; repo=""
    while [ $# -gt 0 ]; do
      case "$1" in
        -t|--tag) [ $# -ge 2 ] || die "$1 needs a tag"; tags+=("$2"); shift 2 ;;
        -p|--priority)
          [ $# -ge 2 ] || die "$1 needs a priority (high, medium, low)"
          priority="$(priority_of "$2")"; shift 2 ;;
        -r|--repo|--repository)
          [ $# -ge 2 ] || die "$1 needs a repository"
          repo="$2"; shift 2 ;;
        *) die "unexpected argument '$1' (try: amd help)" ;;
      esac
    done
    [ -n "${repo}" ] || repo="$(default_repo)"
    id="$(next_id)"; slug="$(slugify "${title}")"
    file="${BOARD}/todo/${id}-${slug}.md"
    taglist=""
    if [ "${#tags[@]}" -gt 0 ]; then taglist="$(IFS=,; printf '%s' "${tags[*]}")"; fi
    {
      printf -- '---\n'
      printf 'id: "%s"\n' "${id}"
      printf 'title: "%s"\n' "${title}"
      printf 'repository: "%s"\n' "${repo}"
      printf 'priority: "%s"\n' "${priority}"
      printf 'created: "%s"\n' "$(date +%F)"
      printf 'tags: [%s]\n' "${taglist}"
      printf -- '---\n\n## Notes\n\n\n## Checklist\n\n- [ ] \n'
    } > "${file}"
    printf 'created todo/%s-%s.md\n' "${id}" "${slug}"
    ;;
  board|ls|list)
    parse_filters "$@"
    if [ "${TARGET}" = "all" ]; then
      for c in "${COLUMNS[@]}"; do list_column "${c}"; done
    else
      list_column "${TARGET}"
    fi
    ;;
  set)
    ref="${1:?usage: amd set <ref> <priority|repository> <value>}"
    field="${2:?usage: amd set <ref> <priority|repository> <value>}"
    value="${3:?usage: amd set <ref> <priority|repository> <value>}"
    file="$(find_task "${ref}")"
    case "$(lower "${field}")" in
      # Assign first: a `die` inside a substitution used as an argument would
      # leave the field set to the empty string.
      p|pri|priority) level="$(priority_of "${value}")"; set_field "${file}" priority "${level}" ;;
      r|repo|repository) set_field "${file}" repository "${value}" ;;
      *) die "unknown field '${field}' (use: priority, repository)" ;;
    esac
    ;;
  start)
    # Assign first: a `die` inside a substitution used directly as an argument
    # only kills the subshell, so the command would run on an empty path and
    # report a second, confusing error.
    file="$(find_task "${1:?usage: amd start <ref>}")"
    move "${file}" doing
    ;;
  "done")
    file="$(find_task "${1:?usage: amd done <ref>}")"
    move "${file}" "done"
    ;;
  back)
    file="$(find_task "${1:?usage: amd back <ref>}")"
    case "$(column_of "${file}")" in
      done) move "${file}" doing ;;
      doing) move "${file}" todo ;;
      todo) die "already in todo/" ;;
    esac
    ;;
  archive)
    file="$(find_task "${1:?usage: amd archive <ref>}")"
    archive_task "${file}"
    ;;
  clean|cleanup) clean_archive ;;
  show)
    file="$(find_task "${1:?usage: amd show <ref>}")"
    cat "${file}"
    ;;
  edit)
    file="$(find_task "${1:?usage: amd edit <ref>}")"
    "${EDITOR:-vi}" "${file}"
    ;;
  *) die "unknown command '${cmd}' (try: amd help)" ;;
esac
