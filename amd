#!/usr/bin/env bash
#
# amd — a tiny filesystem Kanban in markdown (agile-md).
#
# Install this on your PATH (see agile-md/install.sh) and it operates on the
# board at <repository-root>/tasks (todo/ doing/ done/), discovered from your
# current directory — so `amd` works in any git repository.
#
#   amd init                          create the board in this repository
#   amd new "<title>" [-t tag ...]    create a task in todo/
#   amd board                         show all columns (default)
#   amd ls [todo|doing|done|all]      list a column
#   amd start <ref>                   todo  -> doing
#   amd done  <ref>                   doing -> done
#   amd back  <ref>                   move a task one column left
#   amd show  <ref>                   print a task
#   amd edit  <ref>                   open a task in $MARKDOWN_EDITOR
#
# <ref> is a task id (e.g. 7 or 007) or a unique slug substring.
# Set AMD_DIR to use a board directory other than "tasks". `amd edit` uses
# $MARKDOWN_EDITOR, falling back to $EDITOR (and then vi) if it's unset,
# empty, or names a command you haven't got installed.
#
set -euo pipefail

COLUMNS=(todo doing "done")

die() { printf 'amd: %s\n' "$*" >&2; exit 1; }

# Board = <repo-root>/${AMD_DIR:-tasks}, discovered from the current directory.
board_dir() {
  local root
  root="$(git rev-parse --show-toplevel 2>/dev/null || true)"
  [ -n "${root}" ] || die "not inside a git repository (agile-md boards live at <repo>/${AMD_DIR:-tasks})"
  printf '%s/%s' "${root}" "${AMD_DIR:-tasks}"
}

slugify() {
  printf '%s' "$1" | tr '[:upper:]' '[:lower:]' \
    | sed -E 's/[^a-z0-9]+/-/g; s/^-+//; s/-+$//' | cut -c1-50
}

meta() { awk -F'"' -v k="$2" 'index($0, k": ")==1 {print $2; exit}' "$1"; }

column_of() { basename "$(dirname "$1")"; }

next_id() {
  local max=0 n f c
  for c in "${COLUMNS[@]}"; do
    for f in "${BOARD}/${c}"/*.md; do
      [ -e "${f}" ] || continue
      n="$(basename "${f}" | sed -E 's/^0*([0-9]+)-.*/\1/')"
      [[ "${n}" =~ ^[0-9]+$ ]] && [ "${n}" -gt "${max}" ] && max="${n}"
    done
  done
  printf '%03d' $((max + 1))
}

find_task() { # <ref> -> prints the matching file path (must be unique)
  local ref="$1" f base c hits=()
  for c in "${COLUMNS[@]}"; do
    for f in "${BOARD}/${c}"/*.md; do
      [ -e "${f}" ] || continue
      base="$(basename "${f}" .md)"
      if [[ "${ref}" =~ ^[0-9]+$ ]]; then
        [[ "${base}" =~ ^0*${ref}- ]] && hits+=("${f}")
      else
        [[ "${base}" == *"${ref}"* ]] && hits+=("${f}")
      fi
    done
  done
  [ "${#hits[@]}" -eq 0 ] && die "no task matches '${ref}'"
  [ "${#hits[@]}" -gt 1 ] && die "'${ref}' matches ${#hits[@]} tasks; be more specific"
  printf '%s' "${hits[0]}"
}

move() { # <file> <dest-column>
  local src="$1" col="$2" dest
  dest="${BOARD}/${col}/$(basename "${src}")"
  [ "$(column_of "${src}")" = "${col}" ] && die "already in ${col}/"
  if git -C "${BOARD}" ls-files --error-unmatch "${src}" >/dev/null 2>&1; then
    git -C "${BOARD}" mv "${src}" "${dest}"
  else
    mv "${src}" "${dest}"
  fi
  printf 'moved %s -> %s/\n' "$(basename "${src}")" "${col}"
}

list_column() {
  local c="$1" f id title found=0
  printf '\n%s\n' "$(printf '%s' "${c}" | tr '[:lower:]' '[:upper:]')"
  for f in "${BOARD}/${c}"/*.md; do
    [ -e "${f}" ] || continue
    found=1
    id="$(meta "${f}" id)"; title="$(meta "${f}" title)"
    printf '  [%s] %s\n' "${id:-???}" "${title:-$(basename "${f}" .md)}"
  done
  if [ "${found}" -eq 0 ]; then printf '  (empty)\n'; fi
}

# Tasks are markdown, so MARKDOWN_EDITOR wins if it's set to something this
# machine actually has; otherwise EDITOR, otherwise vi. Skipping a candidate
# that isn't installed keeps a shared dotfile working on a machine without it.
# Values may carry arguments ("code -w") — only the command has to exist.
EDITOR_ARGV=()
resolve_editor() {
  local candidate parts=()
  for candidate in "${MARKDOWN_EDITOR:-}" "${EDITOR:-}" vi; do
    [ -n "${candidate}" ] || continue
    read -r -a parts <<< "${candidate}"
    [ "${#parts[@]}" -gt 0 ] || continue
    if command -v "${parts[0]}" >/dev/null 2>&1; then
      EDITOR_ARGV=("${parts[@]}")
      return 0
    fi
  done
  die "no editor found (set MARKDOWN_EDITOR or EDITOR)"
}

create_board() { # scaffolds the board at $BOARD
  mkdir -p "${BOARD}/todo" "${BOARD}/doing" "${BOARD}/done"
  for c in todo doing "done"; do
    [ -e "${BOARD}/${c}/.gitkeep" ] || : > "${BOARD}/${c}/.gitkeep"
  done
  if [ ! -e "${BOARD}/README.md" ]; then
    printf '# Tasks (agile-md)\n\nA filesystem Kanban managed by the `amd` command.\nStatus is the folder; `git mv` between columns is the audit trail.\nSee https://github.com/mrdoodles/agile-md\n' > "${BOARD}/README.md"
  fi
}

# Resolve the board; if it doesn't exist, offer to create it (prompt when
# interactive, AMD_YES=1 to force, otherwise a clear error so it never hangs).
ensure_board() {
  BOARD="$(board_dir)"
  [ -d "${BOARD}" ] && return 0
  local reply=""
  if [ "${AMD_YES:-}" = "1" ]; then
    reply=y
  elif [ -t 0 ]; then
    printf 'No task board found at %s\nCreate an empty board here? [y/N] ' "${BOARD}" >&2
    read -r reply
  else
    die "no board at ${BOARD} — run 'amd init' (or set AMD_YES=1)"
  fi
  case "${reply}" in
    y|Y|yes|Yes|YES) create_board; printf 'Created board at %s\n' "${BOARD}" >&2 ;;
    *) die "no board created" ;;
  esac
}

usage() { awk 'NR>=3 && /^#/ {sub(/^# ?/, ""); print; next} NR>=3 {exit}' "${BASH_SOURCE[0]}"; }

cmd="${1:-board}"; [ $# -gt 0 ] && shift || true

case "${cmd}" in help|-h|--help) usage; exit 0 ;; esac

if [ "${cmd}" = "init" ]; then
  BOARD="$(board_dir)"
  create_board
  printf 'Initialised agile-md board at %s\n' "${BOARD}"
  exit 0
fi

ensure_board

case "${cmd}" in
  new)
    title="${1:-}"; [ -n "${title}" ] || die 'usage: amd new "<title>" [-t tag ...]'
    shift
    tags=()
    while [ $# -gt 0 ]; do
      case "$1" in -t|--tag) tags+=("$2"); shift 2 ;; *) shift ;; esac
    done
    id="$(next_id)"; slug="$(slugify "${title}")"
    file="${BOARD}/todo/${id}-${slug}.md"
    taglist=""
    [ "${#tags[@]}" -gt 0 ] && taglist="$(IFS=,; printf '%s' "${tags[*]}")"
    {
      printf -- '---\n'
      printf 'id: "%s"\n' "${id}"
      printf 'title: "%s"\n' "${title}"
      printf 'created: "%s"\n' "$(date +%F)"
      printf 'tags: [%s]\n' "${taglist}"
      printf -- '---\n\n## Notes\n\n\n## Checklist\n\n- [ ] \n'
    } > "${file}"
    printf 'created todo/%s-%s.md\n' "${id}" "${slug}"
    ;;
  board)
    for c in "${COLUMNS[@]}"; do list_column "${c}"; done
    ;;
  ls|list)
    target="${1:-all}"
    if [ "${target}" = "all" ]; then
      for c in "${COLUMNS[@]}"; do list_column "${c}"; done
    else
      list_column "${target}"
    fi
    ;;
  start) move "$(find_task "${1:?usage: amd start <ref>}")" doing ;;
  done)  move "$(find_task "${1:?usage: amd done <ref>}")" "done" ;;
  back)
    file="$(find_task "${1:?usage: amd back <ref>}")"
    case "$(column_of "${file}")" in
      done) move "${file}" doing ;;
      doing) move "${file}" todo ;;
      todo) die "already in todo/" ;;
    esac
    ;;
  show) cat "$(find_task "${1:?usage: amd show <ref>}")" ;;
  edit)
    file="$(find_task "${1:?usage: amd edit <ref>}")"
    resolve_editor
    "${EDITOR_ARGV[@]}" "${file}"
    ;;
  *) die "unknown command '${cmd}' (try: amd help)" ;;
esac
